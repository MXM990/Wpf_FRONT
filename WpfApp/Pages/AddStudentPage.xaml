<Page x:Class="WpfApp.Pages.AddStudentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="إضافة طالب" FlowDirection="RightToLeft">

    <Grid Background="#F5F7FA">
        <Border Background="White" CornerRadius="8" Margin="30" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
            <StackPanel>
                <TextBlock Text="إضافة طالب جديد" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <TextBlock Text="الاسم" Foreground="#34495E" Margin="0,5"/>
                <TextBox x:Name="TxtStudentName" Height="35" FontSize="14" VerticalContentAlignment="Center" Padding="5" BorderBrush="#BDC3C7"/>

                <TextBlock Text="العمر" Foreground="#34495E" Margin="0,15,0,5"/>
                <TextBox x:Name="TxtStudentAge" Height="35" FontSize="14" VerticalContentAlignment="Center" Padding="5" BorderBrush="#BDC3C7"/>

              
                <TextBlock Text="القاعة" Foreground="#34495E" Margin="0,15,0,5"/>
                <ComboBox x:Name="CmbHalls" Height="35" FontSize="14" VerticalContentAlignment="Center" Padding="5" BorderBrush="#BDC3C7"/>

                <TextBlock Text="رقم الهاتف" Foreground="#34495E" Margin="0,15,0,5"/>
                <TextBox x:Name="TxtStudentPhone" Height="35" FontSize="14" VerticalContentAlignment="Center" Padding="5" BorderBrush="#BDC3C7"/>

                <Button Content="تسجيل الطالب" Height="40" Background="#2C3E50" Foreground="White" 
                        FontSize="16" FontWeight="Bold" Margin="0,25,0,0" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>