<Page x:Class="WpfApp.Pages.AddHallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="إضافة قاعة" FlowDirection="RightToLeft">

    <Grid Background="#F5F7FA">
        <Border Background="White" CornerRadius="8" Margin="30" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
            <StackPanel>
                <TextBlock Text="إضافة قاعة جديدة" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <TextBlock Text="اسم القاعة" Foreground="#34495E" Margin="0,5"/>
                <TextBox Height="35" FontSize="14" VerticalContentAlignment="Center" Padding="5" BorderBrush="#BDC3C7"/>

                <TextBlock Text="السعة الإستيعابية" Foreground="#34495E" Margin="0,15,0,5"/>
                <TextBox Height="35" FontSize="14" VerticalContentAlignment="Center" Padding="5" BorderBrush="#BDC3C7"/>

                <Button Content="حفظ القاعة" Height="40" Background="#2C3E50" Foreground="White" 
                        FontSize="16" FontWeight="Bold" Margin="0,25,0,0" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>