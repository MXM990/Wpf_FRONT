<Page x:Class="WpfApp.Pages.AddTeacherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="إضافة أستاذ" FlowDirection="RightToLeft">

    <Grid Background="#F5F7FA">
        <Border Background="White" CornerRadius="8" Margin="30" Padding="25" VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
            <StackPanel>
                <TextBlock Text="إضافة أستاذ جديد" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <TextBlock Text="اسم الأستاذ الكامل" Foreground="#34495E" Margin="0,5"/>
                <TextBox x:Name="TxtTeacherName" Height="35" FontSize="14" VerticalContentAlignment="Center" Padding="5" BorderBrush="#BDC3C7"/>

                <TextBlock Text="المادة/التخصص" Foreground="#34495E" Margin="0,15,0,5"/>
                <TextBox x:Name="TxtSubject" Height="35" FontSize="14" VerticalContentAlignment="Center" Padding="5" BorderBrush="#BDC3C7"/>

                <TextBlock Text="القاعة المخصصة" Foreground="#34495E" Margin="0,15,0,5"/>
                <ComboBox x:Name="CmbHalls" Height="35" FontSize="14" VerticalContentAlignment="Center" Padding="5" BorderBrush="#BDC3C7"/>

                <TextBlock Text="رقم الهاتف" Foreground="#34495E" Margin="0,15,0,5"/>
                <TextBox x:Name="TxtTeacherPhone" Height="35" FontSize="14" VerticalContentAlignment="Center" Padding="5" BorderBrush="#BDC3C7"/>

                <Button Content="حفظ البيانات" Height="40" Background="#2C3E50" Foreground="White" 
                        FontSize="16" FontWeight="Bold" Margin="0,25,0,0" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>