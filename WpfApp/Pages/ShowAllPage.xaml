<Page x:Class="WpfApp.Pages.ShowAllPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="عرض البيانات" FlowDirection="RightToLeft">

    <Grid Background="#F5F7FA" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="سجل البيانات الشاملة" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" AutoGenerateColumns="True" Background="White" 
                  RowHeight="35" ColumnHeaderHeight="40" GridLinesVisibility="Horizontal" 
                  HorizontalGridLinesBrush="#E0E0E0" BorderThickness="1" BorderBrush="#BDC3C7"/>
    </Grid>
</Page>